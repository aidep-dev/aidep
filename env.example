# copy to .env.local (never committed)
DATABASE_URL=postgres://postgres@localhost:5433/aidep
# from the GitHub App registration (manifest flow)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# public base URL of the app (tunnel URL during development)
APP_URL=http://localhost:3000
# where the deprecation registry lives: local checkout in dev, raw URL in prod
REGISTRY_SOURCE=../aidep-registry/registry
