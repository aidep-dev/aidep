# copy to .env.local (never committed)
DATABASE_URL=postgres://postgres@localhost:5433/aidep

# from the GitHub App registration
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# the App's OAuth credentials (dashboard sign-in)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# the App's public slug, for install links on the site
NEXT_PUBLIC_GITHUB_APP_SLUG=

# public base URL of the app (tunnel URL during development)
APP_URL=http://localhost:3000

# where the deprecation registry lives: local checkout in dev, raw URL in prod
# prod: https://raw.githubusercontent.com/aidep-dev/aidep-registry/master/registry
REGISTRY_SOURCE=../aidep-registry/registry

# session cookie encryption key: any long random string
SESSION_SECRET=

# protects /api/cron/drain; Vercel sends it automatically when set
CRON_SECRET=

# public-read GitHub token for the daily code-search snapshot behind /dead;
# unset just leaves that page empty
GITHUB_SEARCH_TOKEN=

# our key for eval-case extraction (one small call per changed file when a
# customer opts into evals); leave unset to skip eval packs
ANTHROPIC_API_KEY=
# AIDEP_EXTRACT_MODEL=claude-sonnet-4-6

# outbound mail (deprecation alerts to `notify` addresses, waitlist mail);
# leave both unset and nothing is sent, only logged
RESEND_API_KEY=
MAIL_FROM=aidep <watch@aidep.dev>
